      "equipment": [
        "33 cm 平底鍋",
        "6 L 湯鍋",
        "6 Qt Instant Pot",
        "烤箱",
        "溫度計"
      ],
      "difficulty": [
        "兩鍋溫和燉煮",
        "咖哩塊關火後融化",
        "雞胸後下並測熟度"
      ],
      "steps": [
        "先煮飯、另烤花椰菜。",
        "切菜，最後處理生雞肉。",
        "炒洋蔥，最後炒蒜。",
        "兩鍋各加入一半蔬菜及水，微滾至蔬菜軟。",
        "每鍋下 1097 g 雞胸，恢復微滾並測中心熟度。",
        "關火融化每鍋 1.5 盒咖哩塊，再小火攪拌增稠。",
        "咖哩分七份；六份配飯菜，第七份純咖哩。"
      ],
